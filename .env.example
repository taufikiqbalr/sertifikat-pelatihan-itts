# PostgreSQL/Neon database connection.
# Neon Native Integration biasanya menyediakan DATABASE_URL otomatis.
DATABASE_URL=

# Admin credentials
ADMIN_EMAIL=admin@itts.ac.id
ADMIN_PASSWORD=

# Sangat disarankan di production. Jika belum diisi, aplikasi sementara
# membuat signing key turunan dari ADMIN_EMAIL + ADMIN_PASSWORD agar login tidak crash.
AUTH_SECRET=

# Optional. Jika dikonfigurasi, uploaded certificate templates disimpan di Vercel Blob.
# Tanpa token ini, upload masih menggunakan fallback database-inline.
BLOB_READ_WRITE_TOKEN=

# Optional canonical production URL, e.g. https://sertifikat.itts.ac.id
NEXT_PUBLIC_APP_URL=


# Google Drive certificate archive (optional).
# Preferred for a normal My Drive account: OAuth 2.0 user credentials.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional. If empty in OAuth-user mode, the app creates/reuses a root folder
# named "Sertifikat Pelatihan ITTS" in the authenticated user's My Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Sertifikat Pelatihan ITTS

# Alternative: service account. Without domain-wide impersonation, use a folder
# located on a Google Shared Drive because service accounts cannot own Drive files.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_IMPERSONATE_USER=
