# PostgreSQL/Neon database connection
DATABASE_URL=

# Admin credentials
ADMIN_EMAIL=admin@itts.ac.id
ADMIN_PASSWORD=
AUTH_SECRET=

# Optional. If configured, uploaded certificate templates are stored in Vercel Blob.
# Without this token, uploads are stored as base64 data inside PostgreSQL (max 4 MB/image).
BLOB_READ_WRITE_TOKEN=

# Optional canonical production URL, e.g. https://sertifikat.itts.ac.id
NEXT_PUBLIC_APP_URL=
