# PostgreSQL/Neon database connection.
# Neon Native Integration biasanya menyediakan DATABASE_URL otomatis.
DATABASE_URL=

# Admin credentials
ADMIN_EMAIL=admin@itts.ac.id
ADMIN_PASSWORD=

# Sangat disarankan di production. Jika belum diisi, aplikasi sementara
# membuat signing key turunan dari ADMIN_EMAIL + ADMIN_PASSWORD agar login tidak crash.
AUTH_SECRET=

# Optional. Jika dikonfigurasi, uploaded certificate templates disimpan di Vercel Blob.
# Tanpa token ini, upload masih menggunakan fallback database-inline.
BLOB_READ_WRITE_TOKEN=

# Optional canonical production URL, e.g. https://sertifikat.itts.ac.id
NEXT_PUBLIC_APP_URL=
